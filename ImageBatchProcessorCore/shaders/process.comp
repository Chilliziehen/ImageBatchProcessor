#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x=16,local_size_y=16) in;
layout(binding=0,rgba32f) uniform readonly image2D src;
layout(binding=1,rgba32f) uniform writeonly image2D dst;
layout(std430,binding=2) readonly buffer Parameters {float arg[];};
layout(push_constant) uniform Push {uint index;uint pass;uint width;uint height;} pc;
float p(int k){return arg[pc.index*256+k];}
float maskAt(vec2 uv,float y){
 float feather=max(p(52),.001),m=1;
 if(p(30)==1)m=1-smoothstep(max(0.,p(51)-feather),p(51),length(uv-vec2(p(49),p(50))));
 if(p(30)==2){float angle=radians(p(53));m=smoothstep(-feather,feather,dot(uv-vec2(p(49),p(50)),vec2(cos(angle),sin(angle))));}
 if(p(30)==3)m=smoothstep(p(57),p(57)+feather,y)*(1-smoothstep(p(58)-feather,p(58),y));
 if(p(56)>0)m=1-m;return clamp(m*p(31),0,1);
}
vec3 fetch(ivec2 xy){return imageLoad(src,clamp(xy,ivec2(0),imageSize(src)-1)).rgb;}
vec3 bilinear(vec2 xy){ivec2 q=ivec2(floor(xy));vec2 f=fract(xy);return mix(mix(fetch(q),fetch(q+ivec2(1,0)),f.x),mix(fetch(q+ivec2(0,1)),fetch(q+ivec2(1,1)),f.x),f.y);}
float curve(float x,int offset){
 if(pc.width!=0){uint channel=offset==32?0:(offset==96?1:(offset==113?2:3));
 float t=clamp(x,0,1)*1023;uint i=min(uint(t),1022);
 return mix(arg[pc.width+channel*1024+i],arg[pc.width+channel*1024+i+1],t-i);}
float t=clamp(x,0,1)*16;int i=min(int(t),15);return mix(p(offset+i),p(offset+i+1),t-i);}
void main(){ivec2 q=ivec2(gl_GlobalInvocationID.xy);if(any(greaterThanEqual(q,imageSize(dst))))return;vec2 size=vec2(imageSize(src)),uv=(vec2(q)+.5)/size;vec3 c=fetch(q);
 if(pc.pass==4){c=clamp(encode(c),0,1);}
 else if(pc.pass==0){ // Geometry: inverse Panini, radial distortion, perspective, crop/rotation and CA.
  vec2 n=(uv*2-1)/max(p(24),.01);float a=radians(p(19));n=mat2(cos(a),sin(a),-sin(a),cos(a))*n;
  n/=max(.1,1+p(22)*n.x+p(23)*n.y);float d=p(17),hf=radians(clamp(p(18),10,160))*.5;
  if(abs(d)>.00001){float edge=(d+1)*sin(hf)/(d+cos(hf));float x=n.x*edge;float theta=atan(x,d+1)+asin(clamp(x*d/sqrt(x*x+(d+1)*(d+1)),-.999,.999));float s=(d+1)/(d+cos(theta));n.x=tan(theta)/tan(hf);n.y=n.y*edge/max(s*cos(theta)*tan(hf),.001);}
  float r2=dot(n,n);n*=1+p(20)*r2+p(21)*r2*r2;vec2 xy=(n*.5+.5)*size-.5;
  c=bilinear(xy);if(p(25)!=0){c.r=bilinear((n*(1+p(25))*.5+.5)*size-.5).r;c.b=bilinear((n*(1-p(25))*.5+.5)*size-.5).b;}
  if(any(lessThan(xy,vec2(0)))||any(greaterThan(xy,size-1)))c=vec3(0);
 }else if(pc.pass==1){ // Edge-aware noise reduction and hot-pixel suppression, linear light.
  if(p(13)>0){vec3 sum=vec3(0);float wsum=0;float sigma=max(.0005,p(13)*.045);for(int j=-2;j<=2;j++)for(int i=-2;i<=2;i++){vec3 s=fetch(q+ivec2(i,j));float w=exp(-float(i*i+j*j)/5-dot(s-c,s-c)/(sigma*sigma));sum+=w*s;wsum+=w;}c=mix(c,sum/wsum,clamp(p(13),0,1));}
 }else if(pc.pass==2){ // Scene-linear exposure, WB, tonal range, then display-referred creative controls.
  float localMask=p(30)>0?maskAt(uv,dot(encode(c),LUMA)):0;
  c*=exp2(p(0)+localMask*p(54))*vec3(exp2(p(9)*.2+p(10)*.08),exp2(-p(10)*.08),exp2(-p(9)*.2+p(10)*.08));
  c=vec3(dot(c,vec3(p(160),p(161),p(162))),dot(c,vec3(p(163),p(164),p(165))),dot(c,vec3(p(166),p(167),p(168))));
  float y=max(dot(c,LUMA),1e-7);float sh=p(2)*exp(-y*6),hi=p(3)*smoothstep(.15,1,y);c*=exp2(sh+hi);
  c=max((c-vec3(p(4)))/max(.01,p(5)-p(4)),vec3(0));
  float mx=max(c.r,max(c.g,c.b));if(p(28)>0&&mx>.60){float mapped=.60+.35*(1-exp(-(mx-.60)/.35));c*=mix(1,mapped/mx,clamp(p(28),0,1));}
  c=encode(c);c=clamp((c-.5)*p(1)+.5,0,1);c=pow(c,vec3(1/max(.1,p(11))));
  float oldY=max(dot(c,LUMA),1e-6);c*=curve(oldY,32)/oldY;c=vec3(curve(c.r,96),curve(c.g,113),curve(c.b,130));
  if(p(15)!=0)c=clamp((c-vec3(p(15)*.06))/(1-p(15)*.12),0,1);
  vec3 h=rgbhsl(clamp(c,0,1));float sector=fract(h.x)*8;int s0=int(sector)%8,s1=(s0+1)%8;vec3 hmod=mix(vec3(p(64+s0*3),p(65+s0*3),p(66+s0*3)),vec3(p(64+s1*3),p(65+s1*3),p(66+s1*3)),fract(sector));
  h.x=fract(h.x+p(8)/360+hmod.x/360);h.y=clamp(h.y*p(6)*(1+p(7)*(1-h.y))*(1+hmod.y)*(1+localMask*p(55)),0,1);h.z=clamp(h.z+hmod.z,0,1);c=hslrgb(h);
  float l=dot(c,LUMA);c=mix(c,vec3(l),p(27));
  c+=vec3(p(172),p(173),p(174))*(1-smoothstep(.15,.65,l))+vec3(p(175),p(176),p(177))*smoothstep(.35,.85,l);
  c*=exp2(-p(16)*pow(clamp(length((uv-.5)*1.414),0,1),2));
  if(p(26)>0){float rnd=fract(sin(dot(vec2(q),vec2(12.9898,78.233)))*43758.5453)-.5;c+=rnd*p(26)*.06;}
  c=decode(clamp(c,0,1));
 }else if(pc.pass==3){ // Unsharp mask and local contrast, small bounded kernels.
  if(p(12)!=0||p(14)!=0){vec3 nearBlur=vec3(0),farBlur=vec3(0);for(int j=-1;j<=1;j++)for(int i=-1;i<=1;i++){nearBlur+=fetch(q+ivec2(i,j))/9;farBlur+=fetch(q+ivec2(i,j)*12)/9;}vec3 detail=c-nearBlur;float gate=smoothstep(.001,.012,length(detail));c+=p(12)*detail*gate+p(14)*(c-farBlur)*.3;c=clamp(c,0,1);}
 }
 imageStore(dst,q,vec4(c,1));}
