 }a[l]=va;b[l]=vb;c[l]=vc;d[l]=vd;e[l]=ve;f[l]=vf;barrier();for(uint s=128;s>0;s>>=1){if(l<s){a[l]+=a[l+s];b[l]+=b[l+s];c[l]+=c[l+s];d[l]+=d[l+s];e[l]+=e[l+s];f[l]+=f[l+s];}barrier();}if(l==0){uint o=gl_WorkGroupID.x*24;for(int i=0;i<4;i++){partial[o+i]=a[0][i];partial[o+4+i]=b[0][i];partial[o+8+i]=c[0][i];partial[o+12+i]=d[0][i];partial[o+16+i]=e[0][i];partial[o+20+i]=f[0][i];}}}
