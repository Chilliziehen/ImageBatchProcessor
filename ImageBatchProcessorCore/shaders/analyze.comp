 if(k<sw*sh){ivec2 q=ivec2((k%sw)*pc.stride,(k/sw)*pc.stride);vec3 rgb=clamp(encode(imageLoad(src,q).rgb),0,1);float y=dot(rgb,LUMA),yl=max(dot(imageLoad(src,q).rgb,LUMA),1e-7);float rg=rgb.r-rgb.g,yb=(rgb.r+rgb.g)*.5-rgb.b;float lap=lv(q+ivec2(1,0))+lv(q-ivec2(1,0))+lv(q+ivec2(0,1))+lv(q-ivec2(0,1))-4*y;float grad=abs(lv(q+ivec2(1,0))-y)+abs(lv(q+ivec2(0,1))-y);
  vec3 lin=decode(rgb);vec3 xyz=mat3(.4124564,.2126729,.0193339,.3575761,.7151522,.119192,.1804375,.072175,.9503041)*lin/vec3(.95047,1,1.08883);vec3 lab= mix(7.787*xyz+vec3(16./116.),pow(max(xyz,0),vec3(1./3)),greaterThan(xyz,vec3(.008856)));
  va=vec4(rgb,y);vb=vec4(y*y,log(yl),rgbhsl(rgb).y,1);vc=vec4(rg,rg*rg,yb,yb*yb);vd=vec4(116*lab.y-16,500*(lab.x-lab.y),200*(lab.y-lab.z),lap*lap);ve=vec4(grad,abs(lap),float(y<.005),float(max(rgb.r,max(rgb.g,rgb.b))>.995));vf=vec4(float(grad<.02)*abs(lap),float(grad<.02),0,0);
